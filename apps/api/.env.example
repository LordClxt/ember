NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001

# Database — sqlite (default) | postgres | mysql
DB_PROVIDER=sqlite
DATABASE_URL=file:./data/ember.db
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://ember:ember@localhost:5432/ember
# DB_PROVIDER=mysql
# DATABASE_URL=mysql://ember:ember@localhost:3306/ember
DB_AUTO_MIGRATE=true
