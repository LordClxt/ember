{
  "name": "ember-api",
  "version": "0.0.1",
  "description": "Ember NestJS API",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "bun run --cwd ../../packages/contracts build",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "bun run --cwd ../../packages/contracts build",
    "start": "nest start",
    "prestart:dev": "bun run --cwd ../../packages/contracts build",
    "start:dev": "nest start --watch",
    "prestart:debug": "bun run --cwd ../../packages/contracts build",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prelint": "bun run --cwd ../../packages/contracts build",
    "lint": "oxlint --type-aware src/ test/",
    "pretest": "bun run --cwd ../../packages/contracts build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "pretest:e2e": "bun run --cwd ../../packages/contracts build",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:all": "for p in sqlite postgres mysql; do DB_PROVIDER=$p drizzle-kit generate --name ${MIGRATION_NAME:-migration} || exit 1; done",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ember/contracts": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.7",
    "@libsql/client": "^0.18.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/terminus": "^12.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.4.4"
}
